rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'karthylock@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Connection verification endpoint
    match /test/connection {
      allow read: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profiles with European WhatsApp authentication
    match /users/{userId} {
      allow read: if true;
      allow create, update: if incoming().name is string && incoming().name.size() <= 150;
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if incoming().title is string && incoming().title.size() <= 200 &&
                               incoming().price is number && incoming().price >= 0;
      allow delete: if isAdmin() || true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true;
      allow create: if incoming().customer_email is string &&
                       incoming().items is list &&
                       incoming().total is number;
      allow update: if true;
      allow delete: if isAdmin() || true;
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if incoming().rating is number &&
                       incoming().rating >= 1 &&
                       incoming().rating <= 5 &&
                       incoming().comment is string &&
                       incoming().comment.size() <= 2000;
      allow update, delete: if isAdmin() || true;
    }

    // Customer & Guest Wishlists
    match /wishlists/{wishlistId} {
      allow read, write: if true;
    }

    // Statutory Returns (Widerrufsrecht)
    match /returns/{returnId} {
      allow read, write: if true;
    }

    // Discount Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }

    // Carts
    match /carts/{cartId} {
      allow read, write: if true;
    }
  }
}
