# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Stripe Configuration (Server-side secret key, client-side publishable key)
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# PayPal Configuration (German / EU PayPal integration)
PAYPAL_CLIENT_ID="sandbox_client_id_..."
PAYPAL_CLIENT_SECRET="sandbox_secret_..."
PAYPAL_MODE="sandbox"

# Klarna Configuration (Rechnung, Sofort, Ratenkauf)
KLARNA_API_KEY="klarna_test_api_key_..."
KLARNA_API_SECRET="klarna_test_secret_..."
KLARNA_ENV="playground"

# Giropay / Wero Configuration (German bank direct transfer)
GIROPAY_MERCHANT_ID="giropay_test_merchant_..."
GIROPAY_PROJECT_ID="giropay_test_project_..."

# Supabase Configuration
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

